<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.collabedit</groupId>
    <artifactId>collaborative-document-editor</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Collaborative Document Editor</name>

    <!--
      A DELIBERATE DECISION: the project does NOT inherit from spring-boot-starter-parent.

      The reason follows directly from ADR-0001: crdt-core is to have nothing to do with Spring.
      With the Boot starter as parent, every module — including the algorithm's core — would
      inherit Spring's dependency management, its plugins and its conventions. The architectural
      boundary declared in the ADR would then be only a declaration.

      Instead we import spring-boot-dependencies as a BOM in dependencyManagement, so the versions
      stay consistent while the dependency runs one way and touches only the app module.
    -->

    <modules>
        <module>crdt-core</module>
        <module>app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <spring-boot.version>3.5.0</spring-boot.version>
        <jackson.version>2.18.2</jackson.version>
        <jqwik.version>1.9.2</jqwik.version>
        <assertj.version>3.26.3</assertj.version>
        <junit.version>5.11.4</junit.version>
        <jmh.version>1.37</jmh.version>

        <!--
          Overriding a version managed by spring-boot-dependencies.
          A concrete reason: Testcontainers 1.20.x negotiates Docker API 1.32, and Docker 29+
          (in colima among others) rejects anything below 1.40. It manifests as
          "Could not find a valid Docker environment", which suggests Docker is missing while
          Docker is running — hence this comment, so nobody diagnoses it a second time.
        -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <otel.version>2.13.3</otel.version>

        <surefire.version>3.5.2</surefire.version>
        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <build-helper.version>3.6.0</build-helper.version>
        <exec-plugin.version>3.5.0</exec-plugin.version>

        <!--
          The number of tries in the property-based tests.
          1000 by default with a FIXED seed: determinism in CI, and a counterexample reproducible
          with one command. The nightly build runs `mvn test -Pthorough`, which raises this to
          10 000 and randomises the seed — because its job is to SEARCH for new counterexamples,
          not to repeat the same thousand cases.
        -->
        <jqwik.tries>1000</jqwik.tries>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${otel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <!--
                          A CONSEQUENCE of doing without spring-boot-starter-parent: it is what
                          enables -parameters by default. Without that flag, method parameter
                          names do not reach the bytecode and Spring cannot bind
                          @DestinationVariable or @PathVariable to an argument — it fails only AT
                          RUN TIME, with "Name for argument of type [java.util.UUID] not
                          specified". Compilation passes, the unit tests pass, and only the web
                          layer breaks, at run time.
                        -->
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <!-- serial: we serialise nothing through Serializable.
                                 processing: the JMH generators produce noise regardless. -->
                            <arg>-Xlint:-serial,-processing</arg>
                        </compilerArgs>
                    </configuration>
                    <executions>
                        <execution>
                            <id>default-compile</id>
                            <configuration>
                                <parameters>true</parameters>
                                <compilerArgs>
                                    <arg>-Xlint:all</arg>
                                    <arg>-Xlint:-serial,-processing</arg>
                                    <!--
                                      Warnings as errors ONLY in production code.
                                      In a portfolio project "the build passes but emits forty
                                      warnings" is a bad signal, and zero is easier to maintain
                                      from the start than to clean up at the end. Test code is
                                      exempt deliberately: that is where generated code (JMH) and
                                      constructs whose warnings are intentional live.
                                    -->
                                    <arg>-Werror</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!--
                          BEWARE, A TRAP: Surefire's default patterns are *Test, Test*, *Tests,
                          *TestCase. The property test classes are named *Properties, so without
                          this list they DO NOT RUN — and the build is green regardless.
                          Discovered during the migration from Gradle: the test count dropped from
                          15 to 5 without a single failure. The most dangerous kind of regression
                          in a build configuration is the one that breaks nothing and merely stops
                          checking.

                          A SECOND TIME, CP15: the `MarkCostMeasurement` class passed when run
                          directly (`-Dtest=...`) and did NOT run in the build, because
                          `*Measurement` was not on this list. The same trap, the same symptom — a
                          green build that checks nothing. Hence the fourth pattern.
                        -->
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*Properties.java</include>
                            <include>**/*Measurement.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                        <systemPropertyVariables>
                            <jqwik.tries.default>${jqwik.tries}</jqwik.tries.default>
                            <jqwik.failures.after.default>PREVIOUS_SEED</jqwik.failures.after.default>
                            <jqwik.reporting.usejunitplatform>true</jqwik.reporting.usejunitplatform>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          The nightly build: a random seed and 10× the tries. A counterexample found overnight
          goes into the repository as an ordinary regression test.
        -->
        <profile>
            <id>thorough</id>
            <properties>
                <jqwik.tries>10000</jqwik.tries>
            </properties>
        </profile>
    </profiles>
</project>
