flowchart TD
    Req["REST API request"] --> Q{"exactly one access<br/>annotation declared?"}
    Q -->|none or multiple| Bug["500<br/>handler never runs"]
    Q -->|"@PublicEndpoint"| H["handler"]
    Q -->|"@RequiresAuthentication"| Tok{"valid token?"}
    Q -->|"@RequiresDocumentAccess"| DTok{"valid token?"}
    Tok -->|no| U["401"]
    DTok -->|no| U
    Tok -->|yes| H
    DTok -->|yes| Perm{"document exists and<br/>role permits capability?"}
    Perm -->|no| NF["404<br/>existence is not disclosed"]
    Perm -->|yes| H
    WS["STOMP frame"] --> WTok{"session token unexpired<br/>and document access valid?"}
    WTok -->|yes| WH["handle or deliver frame"]
    WTok -->|no| Deny["refuse frame<br/>keep unsent edits locally"]
