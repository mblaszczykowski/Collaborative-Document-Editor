{
  // The Playwright scenarios and their configuration — SEVEN TypeScript files that nothing was
  // type-checking.
  //
  // `tsconfig.app.json` includes `src`, `tsconfig.test.json` includes `src`, and
  // `tsconfig.node.json` includes exactly `vite.config.ts`. So `e2e/**` and `playwright.config.ts`
  // were in no project at all: `npm run typecheck` — which CI runs as a gate — walked straight
  // past them. The check was `npx tsc -p tsconfig.test.json --listFiles | grep -c /e2e/`, and the
  // answer was 0. A whole test suite outside the compiler is a suite whose breakage is only
  // discovered by running it, and the e2e suite needs a database, a backend and a browser to run.
  //
  // A separate project rather than an addition to an existing one, for the same reason
  // `tsconfig.test.json` exists: these files run in Node under Playwright and use its globals,
  // while `tsconfig.app.json` deliberately withholds the Node types so that server APIs cannot
  // drift into browser code unnoticed.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM as well as ES2023: the specs pass functions to `page.evaluate`, and those bodies are
    // compiled here but run in a browser, so they legitimately touch `document`, `Element` and
    // friends.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
