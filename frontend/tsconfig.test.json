{
  // The tests run in Node (vitest), not in a browser - hence a separate configuration.
  // Adding the Node types to tsconfig.app.json would be simpler, but it would let server APIs into
  // code meant to run in a browser, and the compiler would stop catching their accidental use.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // vite/client has to stay alongside the Node types: without it import.meta.env and the CSS
    // import declarations disappear, and the source files stop type-checking.
    "types": ["node", "vitest/globals", "vite/client"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": []
}
