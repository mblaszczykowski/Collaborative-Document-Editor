# Local configuration — copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is in .gitignore. This file is the committed half of the pair: it carries the NAMES so a
# clone knows what can be set, and none of the values. That split is the point — a repository that
# documents its configuration by shipping a filled-in copy is a repository that leaks it.
#
# Docker Compose reads `.env` from this directory on its own. For a `mvn spring-boot:run` outside
# Compose, export the values first (`set -a; source .env; set +a`).

# ---------------------------------------------------------------------------------------------
# Identity providers
# ---------------------------------------------------------------------------------------------
# With none of these set the application starts with federated sign-in unavailable and no way in
# at all, which is the intended default for a fresh clone (DevLoginDisabledIT asserts it).
#
# The redirect URI you register at the provider must match the port EXACTLY, including the
# scheme. For the default port that is:
#
#     http://localhost:8090/login/oauth2/code/google
#     http://localhost:8090/login/oauth2/code/github
#
# That path is Spring Security's, not this application's — `/login/oauth2/code/{registrationId}`
# is where the OAuth2 client filter listens, and the registration ids are `google` and `github`
# (ClientRegistrations). Registering the app's own URL instead is the usual first mistake and
# produces `redirect_uri_mismatch` at the provider, before any of this code runs.
#
# The client ID is not a secret — it travels in the address bar during the redirect and anybody
# signing in can read it. The client SECRET is: this is a confidential client, the server exchanges
# the authorization code with it, and anybody holding it can complete sign-ins as this application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Development login
# ---------------------------------------------------------------------------------------------
# `true` restores POST /api/login, which mints a session from a typed display name with nothing
# checked. It exists so the application can be run without registering an OAuth client — and it is
# exactly the mechanism federated identity replaced, so it must never be true anywhere reachable.
COLLABEDIT_DEV_LOGIN=false

# ---------------------------------------------------------------------------------------------
# Token signing
# ---------------------------------------------------------------------------------------------
# TokenService refuses to start without this and has no default, deliberately: the alternative is
# a server signing sessions with a key printed in this repository. Compose supplies an obviously
# named local default; anything reachable must set a real one.
#
#     openssl rand -base64 48
COLLABEDIT_AUTH_SECRET=

# ---------------------------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------------------------
# Changing this means re-registering the redirect URIs above — they are matched literally.
COLLABEDIT_PORT=8090
