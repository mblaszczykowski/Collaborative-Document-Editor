root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown używa trailing spaces jako hard line break
trim_trailing_whitespace = false

[*.{kts,gradle}]
indent_size = 4
