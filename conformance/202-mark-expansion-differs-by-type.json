{
  "name" : "202-mark-expansion-differs-by-type",
  "description" : "Bold GROWS when typing at its end, a link does NOT. The entire difference is which side the end anchor sits on - the TS implementation must choose the same.",
  "operations" : [ {
    "r" : 1,
    "l" : 0,
    "t" : "i",
    "s" : "abcdef"
  }, {
    "r" : 1,
    "l" : 6,
    "t" : "m",
    "k" : "bold",
    "a" : [ 1, 1, 0 ],
    "b" : [ 1, 3, 0 ]
  }, {
    "r" : 1,
    "l" : 7,
    "t" : "m",
    "k" : "link",
    "v" : "https://example.test",
    "a" : [ 1, 4, 0 ],
    "b" : [ 1, 5, 1 ]
  }, {
    "r" : 1,
    "l" : 8,
    "t" : "i",
    "or" : 1,
    "ol" : 2,
    "s" : "X"
  }, {
    "r" : 1,
    "l" : 9,
    "t" : "i",
    "or" : 1,
    "ol" : 5,
    "s" : "Y"
  } ],
  "expectedText" : "abcXdefY",
  "expectedFormatting" : [ {
    "from" : 1,
    "to" : 4,
    "marks" : {
      "bold" : null
    }
  }, {
    "from" : 5,
    "to" : 7,
    "marks" : {
      "link" : "https://example.test"
    }
  } ]
}
